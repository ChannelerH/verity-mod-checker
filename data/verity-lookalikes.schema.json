{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritymodchecker.online/data/verity-lookalikes.schema.json",
  "title": "Verity similar-name route snapshot",
  "type": "object",
  "required": ["schemaVersion", "checkedAt", "canonicalUrl", "method", "projects", "routePolicy"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "checkedAt": { "type": "string", "format": "date-time" },
    "canonicalUrl": { "type": "string", "format": "uri" },
    "method": { "type": "string" },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "host",
          "owner",
          "projectId",
          "projectUrl",
          "status",
          "projectType",
          "displayedDownloadsAtCheck",
          "displayedDownloadsApproximate",
          "packageType",
          "sourceNote"
        ],
        "properties": {
          "name": { "type": "string" },
          "host": { "type": "string" },
          "owner": { "type": "string" },
          "projectId": { "type": "string" },
          "projectUrl": { "type": "string", "format": "uri" },
          "status": { "type": "string" },
          "projectType": { "type": "string" },
          "displayedDownloadsAtCheck": { "type": "integer", "minimum": 0 },
          "displayedDownloadsApproximate": { "type": "boolean" },
          "packageType": { "type": "string" },
          "minecraftVersion": { "type": "string" },
          "loader": { "type": "string" },
          "mainFile": { "type": "string" },
          "mainFileRecord": { "type": "string" },
          "mainFileUrl": { "type": "string", "format": "uri" },
          "mainFileDownloadsAtCheck": { "type": "integer", "minimum": 0 },
          "mainFileSizeBytes": { "type": "integer", "minimum": 0 },
          "lastUpdate": { "type": "string" },
          "publishedAt": { "type": "string" },
          "sourceNote": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "routePolicy": { "type": "string" }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritymodchecker.online/data/verity-modpacks.schema.json",
  "title": "Verity Modpack Route Snapshot",
  "type": "object",
  "required": ["schemaVersion", "checkedAt", "canonicalUrl", "method", "modpacks", "routePolicy"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time"
    },
    "canonicalUrl": {
      "type": "string",
      "format": "uri"
    },
    "method": {
      "type": "string"
    },
    "modpacks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "owner",
          "projectId",
          "projectUrl",
          "status",
          "displayedDownloadsAtCheck",
          "displayedDownloadsApproximate",
          "packageType",
          "sourceNote"
        ],
        "properties": {
          "name": { "type": "string" },
          "owner": { "type": "string" },
          "projectId": { "type": "integer" },
          "projectUrl": { "type": "string", "format": "uri" },
          "status": { "type": "string" },
          "displayedDownloadsAtCheck": { "type": "integer", "minimum": 0 },
          "displayedDownloadsApproximate": { "type": "boolean" },
          "packageType": { "type": "string" },
          "minecraftVersion": { "type": "string" },
          "loader": { "type": "string" },
          "mainFile": { "type": "string" },
          "mainFileRecord": { "type": "integer" },
          "secondaryFileRecord": { "type": "integer" },
          "mainFileDownloadsAtCheck": { "type": "integer", "minimum": 0 },
          "lastUpdate": { "type": "string" },
          "sourceNote": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "routePolicy": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
